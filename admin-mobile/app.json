{
  "expo": {
    "name": "ALZAVA Battle IQ Admin",
    "slug": "alzava-battle-iq-admin",
    "version": "1.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "icon": "./assets/app-icon.png",
    "android": {
      "package": "com.alzava.battleiq.admin",
      "versionCode": 2,
      "permissions": ["INTERNET", "VIBRATE"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#020817"
      }
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ]
  }
}
