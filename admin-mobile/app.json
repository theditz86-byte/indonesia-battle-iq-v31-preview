{
  "expo": {
    "name": "ALZAVA Battle Point Admin",
    "slug": "alzava-battle-point-admin",
    "version": "1.4.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "icon": "./assets/app-icon.png",
    "android": {
      "package": "com.alzava.battleiq.admin",
      "versionCode": 5,
      "permissions": [
        "INTERNET",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#020817"
      }
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D4AF37",
          "defaultChannel": "alzava-payments-v2",
          "sounds": [
            "./assets/alzava_payment.wav"
          ]
        }
      ]
    ]
  }
}
