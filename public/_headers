# The local-model Web Worker has its own CSP; all account pages retain the
# existing strict global policy. These exceptions permit WebLLM's pinned
# library and model downloads only inside this isolated worker.
/ai/alzava-local-worker.mjs
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' https://esm.run https://*.esm.run https://cdn.jsdelivr.net https://*.jsdelivr.net 'wasm-unsafe-eval'; connect-src 'self' https://esm.run https://*.esm.run https://cdn.jsdelivr.net https://*.jsdelivr.net https://huggingface.co https://*.huggingface.co https://*.hf.co https://*.xethub.hf.co; object-src 'none'; base-uri 'none'

